---
import 'katex/dist/katex.min.css';
import '../styles/notes.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  /** 当前页面的 slug；首页为 'home' */
  current: string;
}

const { title, description, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = current === 'home' ? title : `${title} · 学习手账`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f5ef" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="学习手账" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <div class="paper-grain" aria-hidden="true"></div>
    <header class="site-header shell">
      <a class="brand" href={base} aria-label="学习手账首页"><span class="brand-icon" aria-hidden="true">✳</span><span>学习手账<span class="brand-period">.</span></span></a>
      <nav aria-label="主导航">
        <a class:list={{ active: current === 'home' }} href={base}>全部笔记</a>
        {notes.map((n) => <a class:list={{ active: current === n.id }} href={`${base}${n.id}/`}>{n.data.short}</a>)}
      </nav>
    </header>

    <main id="top">
      <slot />
    </main>

    <footer class="site-footer shell"><span>© {new Date().getFullYear()} 学习手账</span><span>只留考点，把每个符号讲清楚 <span class="footer-star">✳</span></span><a href="#top">回到顶部 ↑</a></footer>
  </body>
</html>
