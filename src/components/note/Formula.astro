---
/** 公式卡片：上方是公式（slot 中的 $$...$$），下方是含义与考点 */
interface Props { meaning?: string; point?: string }
const { meaning, point } = Astro.props;
---
<div class="formula-card">
  <div class="formula-math"><slot /></div>
  {(meaning || point) && (
    <dl class="formula-notes">
      {meaning && <div><dt>含义</dt><dd><slot name="meaning">{meaning}</slot></dd></div>}
      {point && <div><dt>考点</dt><dd><slot name="point">{point}</slot></dd></div>}
    </dl>
  )}
</div>
