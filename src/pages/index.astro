---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const notes = (await getCollection('notes')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title="学习手账" description="考研 / 期末复习笔记：线性系统理论、合成孔径雷达（SAR）等，只保留必要的考点和知识点。" current="home">
  <section class="hero hero-home shell">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> STUDY NOTES</p>
      <h1>学习手账，<br /><span>只留考点。</span></h1>
      <p class="hero-description">每篇笔记先给一句话主线，再整理公式、必考点和自测题。公式编号与教材保持一致，方便对照复习。</p>
    </div>
  </section>

  <div class="reading">
    <ul class="note-list">
      {notes.map((n, i) => (
        <li>
          <a class="note-card" href={`${base}${n.id}/`}>
            <span class="note-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="note-main">
              <span class="eyebrow">{n.data.eyebrow} · {n.data.course}</span>
              <strong>{n.data.title}</strong>
              <span class="note-desc">{n.data.description}</span>
            </span>
            {n.data.status && <span class="note-status">{n.data.status}</span>}
            <span class="note-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
